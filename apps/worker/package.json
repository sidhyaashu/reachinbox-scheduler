{
  "name": "@reachinbox/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }) } catch (e) {}\""
  },
  "dependencies": {
    "@reachinbox/database": "*",
    "@reachinbox/queue": "*",
    "@reachinbox/shared": "*",
    "express": "^4.21.2",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.7.3"
  }
}
